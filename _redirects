# Cloudflare Pages 配置

[build]
command = "npm install && npm run build"
output_dir = "dist"

[build.environment]
NODE_VERSION = "20"
NPM_FLAGS = "--prefer-offline"

[[redirects]]
from = "/api/*"
to = "/.netlify/functions/:splat"
status = 200
force = false

[[redirects]]
from = "/*"
to = "/index.html"
status = 200
